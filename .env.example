# ─────────────────────────────────────────────────────────────────────────────
#  Variables de entorno para docker-compose
#
#  Instrucciones:
#    1. cp .env.example .env
#    2. Cambia POSTGRES_PASSWORD por un valor seguro
#    3. docker-compose up --build
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=monitoring_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme          # ← OBLIGATORIO: cámbialo antes de arrancar

# ── Puertos expuestos en el host ──────────────────────────────────────────────
BACKEND_PORT=3000
FRONTEND_PORT=80

# ── URL del API accesible desde el navegador ──────────────────────────────────
# Vite la incrusta en el bundle durante el build; debe ser alcanzable
# desde la máquina del usuario (no desde dentro de Docker).
VITE_API_URL=http://localhost:3000

# ── CORS: origen permitido por el backend ─────────────────────────────────────
# Debe coincidir con la URL desde la que el navegador carga el frontend.
# Si FRONTEND_PORT != 80 ajusta aquí, p. ej.: http://localhost:8080
FRONTEND_ORIGIN=http://localhost
